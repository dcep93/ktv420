{
  "manifest_version": 3,
  "name": "ktv420",
  "version": "7.4.0",
  "minimum_chrome_version": "121",
  "description": "Spotify capture for ktv420. Import, separate, mix and visualize music locally at ktv420.web.app.",
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "host_permissions": [
    "https://open.spotify.com/*",
    "https://ktv420.web.app/*"
  ],
  "action": {
    "default_title": "Open ktv420 on Spotify"
  },
  "background": {
    "service_worker": "build/background.js",
    "type": "module"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; frame-src https://ktv420.web.app; connect-src 'none'; style-src 'self';"
  },
  "content_scripts": [
    {
      "matches": [
        "https://open.spotify.com/*"
      ],
      "js": [
        "src/content/boot.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/favicon.svg",
        "assets/icon-*.png",
        "src/content/*.js",
        "src/page/*.js",
        "src/overlay/index.html"
      ],
      "matches": [
        "https://open.spotify.com/*"
      ]
    }
  ],
  "externally_connectable": {
    "matches": [
      "https://ktv420.web.app/*"
    ]
  }
}
